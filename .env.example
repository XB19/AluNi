# Configuration Docker : copiez ce fichier en .env et renseignez vos valeurs.
# Le fichier .env contient des secrets : il n'est jamais versionné.

# Base de données
DB_USERNAME=postgres
DB_PASSWORD=

# Clé de signature des jetons de connexion (32 caractères minimum, aléatoire)
JWT_SECRET=
# Clé de signature numérique des certificats (aléatoire, à ne jamais changer une fois en production)
CERT_SECRET=

# Données de démonstration au premier démarrage (mettre false en production)
SEED_DEMO_DATA=true
DEMO_PASSWORD=

# Premier compte administrateur, créé au démarrage s'il n'existe encore aucun administrateur
# (indispensable en production, avec SEED_DEMO_DATA=false). 8 caractères minimum pour le mot de passe.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Michel
ADMIN_LAST_NAME=KOUMAI

# Adresse publique du site (utilisée dans les QR codes des certificats et pour CORS)
FRONTEND_URL=http://localhost
# Port HTTP exposé sur la machine
HTTP_PORT=80

# Préfixes d'adresses IP des postes de la salle (mode « examen en salle »)
EXAM_ROOM_IPS=192.168.
