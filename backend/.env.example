# Copiez ce fichier en .env et renseignez vos valeurs (le fichier .env n'est jamais versionné)
DB_URL=jdbc:postgresql://localhost:5432/aluni
DB_USERNAME=postgres
DB_PASSWORD=
# Clé de signature des jetons de connexion (32 caractères minimum)
JWT_SECRET=
# Clé de signature numérique des certificats
CERT_SECRET=
# Mot de passe des comptes de démonstration créés au premier démarrage
DEMO_PASSWORD=
# Optionnel
# FRONTEND_URL=https://aluni.tg
# CORS_ORIGINS=https://aluni.tg
# STORAGE_DIR=/var/aluni/uploads
# SEED_DEMO_DATA=false
# EXAM_ROOM_IPS=192.168.1.
# spring.mail.host=smtp.exemple.com
# spring.mail.port=587
# spring.mail.username=
# spring.mail.password=
# Premier compte administrateur (créé au démarrage s'il n'en existe aucun)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_FIRST_NAME=Michel
# ADMIN_LAST_NAME=KOUMAI
