# Copiez ce fichier en .env et renseignez vos valeurs (le fichier .env n'est jamais versionné)
DB_URL=jdbc:postgresql://localhost:5432/aluni
DB_USERNAME=postgres
DB_PASSWORD=
# Clé de signature des jetons de connexion (32 caractères minimum)
JWT_SECRET=
# Clé de signature numérique des certificats
CERT_SECRET=
# Mot de passe des comptes de démonstration créés au premier démarrage
DEMO_PASSWORD=
# Optionnel
# FRONTEND_URL=https://aluni.tg
# CORS_ORIGINS=https://aluni.tg
# STORAGE_DIR=/var/aluni/uploads
# SEED_DEMO_DATA=false
# EXAM_ROOM_IPS=192.168.1.

# ---- E-mails (codes de récupération, identifiants) : Gmail ou tout serveur SMTP
# Gmail : activez la validation en 2 étapes, puis créez un « mot de passe d'application »
# (Compte Google > Sécurité > Mots de passe des applications) et collez-le dans MAIL_PASSWORD.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=aluni.cdej@gmail.com
# MAIL_PASSWORD=
# MAIL_FROM=aluni.cdej@gmail.com
# MAIL_FROM_NAME=ALuNI – Académie Lumière du Numérique et de l'Innovation

# ---- SMS (codes de récupération, identifiants) : Twilio
# Console Twilio > Account Info : Account SID et Auth Token ; TWILIO_FROM = numéro Twilio (+1…)
# ou identifiant d'un service de messagerie (MG…). Le Togo doit être autorisé dans
# Messaging > Settings > Geo permissions.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Développement uniquement : simule les envois non configurés (codes écrits dans le journal du serveur)
# MESSAGES_LOG_ONLY=true

# ---- Assistant de la plateforme (chatbot)
# Clé de l'API Claude : console.anthropic.com > API Keys. Sans clé, l'assistant répond à partir de la FAQ.
# Chaque visiteur peut envoyer ASSISTANT_MESSAGES_PER_HOUR messages par heure (protège le budget).
# ANTHROPIC_API_KEY=
# ASSISTANT_MESSAGES_PER_HOUR=30

# Premier compte administrateur (créé au démarrage s'il n'en existe aucun)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_FIRST_NAME=Michel
# ADMIN_LAST_NAME=KOUMAI
